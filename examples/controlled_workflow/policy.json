{
  "max_records": 1000,
  "max_calls": 20,
  "require_scope": true,
  "flag_untrusted_instructions": true,
  "denied_tools": [
    "iam.create_key"
  ],
  "allowed_hosts": [],
  "allowed_file_roots": [
    "/workspace/reports"
  ],
  "review_score": 35,
  "sequence_rules": [
    {
      "id": "backup-before-delete",
      "tool": "file.delete",
      "requires_tool": "file.backup",
      "invalidate_on": [
        "file.write"
      ]
    }
  ],
  "tool_policies": {
    "file.backup": {
      "arguments": {
        "backup_path": {
          "path_roots": [
            "/workspace/reports"
          ]
        }
      }
    }
  }
}